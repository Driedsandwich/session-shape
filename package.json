{
  "name": "session-shape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "tsc --project tsconfig.e2e.json && playwright test",
    "build:agents": "tsc --project tsconfig.agents.json",
    "prepare": "npm run build:agents",
    "pretest": "npm run build:agents",
    "analyze": "node lib/agents/cli.js analyze",
    "mcp": "node lib/agents/cli.js mcp"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "bin": {
    "session-shape": "lib/agents/cli.js"
  },
  "files": [
    "lib/",
    "agents/",
    "src/parser.ts",
    "tsconfig.agents.json",
    "docs/AGENTS.md"
  ]
}
